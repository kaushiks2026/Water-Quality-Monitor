# Application Configuration
APP_NAME="Automated Water Quality Monitoring System"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite Local)
# Relative path from project root
DATABASE_URL="sqlite:///./water_quality.db"

# Ingestion Security (Optional shared secret token for devices/simulator)
# If left empty, requests are accepted without X-Device-Token check
DEVICE_API_KEY="dev-secret-token-123"

# Water Quality Threshold Reference (Based on BIS 10500:2012 & WHO Guidelines)
# pH: Acceptable 6.5 to 8.5
PH_MIN=6.5
PH_MAX=8.5

# Turbidity: Acceptable limit <= 1.0 NTU, Permissible <= 5.0 NTU (Warning > 1.0, Critical > 5.0)
TURBIDITY_WARN=1.0
TURBIDITY_MAX=5.0

# Temperature: Typical ambient surface water 20.0 to 32.0 °C
TEMP_MIN=15.0
TEMP_MAX=35.0

# Dissolved Oxygen (DO): Minimum healthy surface water >= 4.0 mg/L (Warning < 6.0, Critical < 4.0)
DO_MIN_CRITICAL=4.0
DO_MIN_WARN=6.0
